# Caddy: TLS, the web app, and a proxy to the API — all on one hostname.
#
# Two site blocks share one handler set: the shared sign-in at app.<domain>,
# and every school at <slug>.<domain>. Both serve the same bundle; the browser
# works out which school it is from its own address.
#
# One origin for both halves means a browser request to /api is same-origin.
# No CORS preflight, no cross-site cookie rules to get wrong. The Flutter apps
# hit the same URLs.
{
	email {$ACME_EMAIL}
	admin off

	# On-demand TLS: a certificate is issued the first time someone visits a
	# school's subdomain, rather than one wildcard for everything.
	#
	# A wildcard certificate would need DNS-01, which needs an API token for the
	# DNS provider — and the domain is on a registrar without a usable API. This
	# gets the same result over HTTP-01 with no DNS credentials anywhere.
	#
	# `ask` is not optional. Without it, anyone resolving `whatever.hamro.school`
	# to this box makes us request a certificate for it, and Let's Encrypt allows
	# 50 per registered domain per week — one bored person could stop new schools
	# onboarding for a week.
	on_demand_tls {
		ask http://api:4000/internal/tls-allowed
	}
}

(hamro) {
	encode zstd gzip

	# The internal TLS gate is for Caddy, from inside the compose network. It
	# must never be reachable through the public /api prefix.
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /health {
		reverse_proxy api:4000
	}

	handle {
		root * /srv/web

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
		level INFO
	}
}

# The shared sign-in and signup. Certificate obtained normally at startup.
{$HAMRO_HOSTNAME} {
	import hamro
}

# Every school.
#
# A catch-all, not `*.hamro.school`. A wildcard site address makes Caddy try to
# obtain an actual wildcard certificate, which Let's Encrypt only issues over
# DNS-01 — and with no DNS provider configured that attempt fails and takes the
# whole server's TLS with it, including the hostname that already had a
# certificate.
#
# A catch-all issues one ordinary certificate per school on first request. What
# stops it answering for any hostname anyone points at this box is the `ask`
# gate in the global block, which only says yes for a real school.
https:// {
	tls {
		on_demand
	}
	import hamro
}
