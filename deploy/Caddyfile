# Caddy: TLS, the web app, and a proxy to the API — all on one hostname.
#
# One origin for both halves means a browser request to /api is same-origin.
# No CORS preflight, no cross-site cookie rules to get wrong, and the refresh
# cookie is simply a cookie. The Flutter apps hit the same URLs.
#
# Certificates are obtained and renewed from Let's Encrypt automatically, as
# soon as the DNS record points here.
{
	email {$ACME_EMAIL}
	# Keep the admin API off; nothing needs it and it is one less listener.
	admin off
}

{$HAMRO_HOSTNAME} {
	encode zstd gzip

	# ── API ─────────────────────────────────────────────────────────────
	# Stripped, so the API keeps serving /auth/login while the browser calls
	# /api/auth/login. The Flutter apps use the same /api prefix.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Health check, unprefixed, for uptime monitoring.
	handle /health {
		reverse_proxy api:4000
	}

	# ── Web app ─────────────────────────────────────────────────────────
	handle {
		root * /srv/web

		# Hashed filenames are immutable; index.html must never be, or a
		# deploy takes a day to reach anyone.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# React Router owns the URL space: a hard refresh on /sign-in has to
		# return index.html rather than a 404.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
		level INFO
	}
}
