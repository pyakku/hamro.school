{
  "name": "hamro-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @hamro/api dev",
    "dev:web": "pnpm --filter @hamro/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hamro/api db:migrate",
    "db:reset": "pnpm --filter @hamro/api db:reset",
    "db:reset-demo": "pnpm --filter @hamro/api db:reset-demo",
    "db:seed": "pnpm --filter @hamro/api db:seed",
    "db:studio": "pnpm --filter @hamro/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
