# ─── Copy to .env and adjust. .env is gitignored. ────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ─── Postgres (docker compose reads these too) ───────────────────────────────
POSTGRES_USER=hamro
POSTGRES_PASSWORD=hamro
POSTGRES_DB=hamro_school_dev
POSTGRES_PORT=5432
APP_DB_PASSWORD=hamro_app

# What the API connects as. Subject to row-level security: a query that loses
# its tenant filter returns no rows rather than another school's data.
DATABASE_URL=postgresql://hamro_app:hamro_app@localhost:5432/hamro_school_dev?schema=public

# What `prisma migrate` and the seed connect as. Owns the tables, so it is not
# subject to RLS. Never used to serve a request.
MIGRATION_DATABASE_URL=postgresql://hamro:hamro@localhost:5432/hamro_school_dev?schema=public

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated. The web dev server in development.
CORS_ORIGINS=http://localhost:5173

# Generate with: openssl rand -base64 48
# Rotating these invalidates every access and refresh token in circulation.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-anything-real
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-anything-real
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Firebase Cloud Messaging (not wired up yet; session 4) ──────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Web (Vite; only VITE_* reaches the browser) ─────────────────────────────
VITE_API_URL=http://localhost:4000
