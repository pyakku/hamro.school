# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

environment  = "staging"
region       = "ap-south-1"
domain       = "hamro.school"
api_hostname = "api.hamro.school"
web_hostname = "app.hamro.school"

# Staging runs one task and a single-AZ database. For production:
#   api_desired_count      = 2
#   db_multi_az            = true
#   db_deletion_protection = true
#   db_backup_retention_days = 30
api_desired_count = 1

# Set true when a customer's security review asks why the tasks have public
# IPs. Costs ~$70/month in NAT gateways across two AZs.
tasks_in_private_subnets = false
