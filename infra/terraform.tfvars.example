# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

# The instance is found by its Name tag, "hamro-<environment>", which is what
# the deploy workflow looks for. Changing this means setting the INSTANCE_TAG
# repository variable in GitHub to match.
environment = "production"

# us-east-1 is ~$0.30/month cheaper and ~250ms slower for users in Nepal and
# India. Not a trade worth making for a product whose main screen has to feel
# instant on a phone.
region = "ap-south-1"

# Caddy serves the web app and proxies /api from this one name, so there is no
# second hostname and no cross-origin anything.
hostname   = "app.hamro.school"
acme_email = "you@your-domain.example"

# Adopt an Elastic IP you already own rather than allocating a second one. AWS
# bills every public IPv4 address whether it is attached or not, so an idle one
# already costs what a new one would.
#   aws ec2 describe-addresses \
#     --query 'Addresses[].{IP:PublicIp,Alloc:AllocationId,Attached:InstanceId}' \
#     --output table
# existing_eip_allocation_id = "eipalloc-0abc123def456"

# There can be only one GitHub OIDC provider per AWS account. Set this false if
# the account already has one from another project, or apply will fail with
# EntityAlreadyExists.
# create_github_oidc_provider = false

# 1 GB is tight for Postgres + Node + Caddy. When a register save feels slow at
# 9am, this is the line to change.
# instance_type = "t4g.small"
